{
  "name": "@aukilabs/auki-sdk-expo",
  "version": "0.1.0",
  "description": "Expo module for authenticated Auki peers (Wasm web, Swift iOS, Kotlin Android)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "files": [
    "android",
    "build",
    "ios",
    "expo-module.config.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "npm run build:wasm && tsc && node scripts/copy-web-artifacts.cjs",
    "clean": "rm -rf build src/web/generated/*",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/json-stringify.test.mjs",
    "test:domain-data": "node scripts/domain-data-bridge.test.cjs",
    "test:jobs": "node scripts/jobs-bridge.test.cjs",
    "test:fleet": "node scripts/fleet-bridge.test.cjs"
  },
  "keywords": [
    "react-native",
    "expo",
    "auki",
    "auki-sdk",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aukilabs/auki-sdk.git",
    "directory": "core/bindings/expo"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
