# INACTIVE TEMPLATE: separate activation approval required. Replace ALL paths.
# Instance names: compute, robot. Private configs must match their instance role.
[Unit]
Description=Core Explorer %i demo worker
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/REPLACE/absolute/auki-sdk
ExecStart=/REPLACE/absolute/venv/bin/python -B /REPLACE/absolute/auki-sdk/core/examples/core-explorer/workers/run.py --config /REPLACE/absolute/private-workers/%i.json
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CPUQuota=25%
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=0
LimitCORE=0
TasksMax=32
LimitNOFILE=256
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=10
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=RUST_LOG=off
# Deliberately no [Install] section: no automatic boot/login activation.
