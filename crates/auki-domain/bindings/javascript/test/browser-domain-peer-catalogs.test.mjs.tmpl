import { readFile } from "node:fs/promises";
import assert from "node:assert/strict";
import test from "node:test";

import initAukiDomain, { AukiBrowserDomainPeer } from "../index.js";

const wasmBytes = await readFile(new URL("../$generated_wasm_file", import.meta.url));
await initAukiDomain({ module_or_path: wasmBytes });

test("AukiBrowserDomainPeer serves declared sensor and resource catalogs over framed protocols", async () => {
  const discovery = new FakeDiscovery();
  const providerNetwork = fakeNetworkPeer("peer-a", ["/webrtc/p2p/peer-a"]);
  const consumerNetwork = fakeNetworkPeer("peer-b", ["/webrtc/p2p/peer-b"]);
  const provider = new AukiBrowserDomainPeer({
    networkPeer: providerNetwork,
    discovery,
    appId: "overwatch",
    displayName: "Browser A",
  });
  await provider.createOrJoin({ discoveryUrl: "http://discovery", clusterName: "overwatch" });
  await provider.declareSensors([{
    sensor_id: "browser-a/audio",
    sensor_hash: "audio-hash",
    kind: "audio",
    label: "Microphone",
  }]);
  const consumer = new AukiBrowserDomainPeer({
    networkPeer: consumerNetwork,
    discovery,
    appId: "overwatch",
    displayName: "Browser B",
  });
  await consumer.createOrJoin({ discoveryUrl: "http://discovery", clusterName: "overwatch" });

  const sensors = JSON.parse(new TextDecoder().decode(await consumerNetwork.requestFramed(
    "/webrtc/p2p/peer-a",
    "/auki/sensors/0.0.1",
    new TextEncoder().encode("{}"),
  )));
  const resources = JSON.parse(new TextDecoder().decode(await consumerNetwork.requestFramed(
    "/webrtc/p2p/peer-a",
    "/auki/resources/0.0.1",
    new TextEncoder().encode("{}"),
  )));

  assert.deepEqual(sensors, {
    sensors: [{
      sensor_id: "browser-a/audio",
      sensor_hash: "audio-hash",
      kind: "audio",
      label: "Microphone",
    }],
  });
  assert.equal(resources.resources[0].kind, "sensor_stream");
  assert.equal(resources.resources[0].sensor_id, "browser-a/audio");
  assert.equal(resources.resources[0].stream_protocol, "/auki/stream/0.1.0");
  assert.deepEqual(
    consumer.snapshot().participants.find((participant) => participant.peer_id === "peer-a").sensors,
    sensors.sensors,
  );
});

test("AukiBrowserDomainPeer manager refreshes a joining browser peer's declared sensors", async () => {
  const discovery = new FakeDiscovery();
  const manager = new AukiBrowserDomainPeer({
    networkPeer: fakeNetworkPeer("peer-manager", ["/webrtc/p2p/peer-manager"]),
    discovery,
    appId: "overwatch",
    displayName: "Manager",
  });
  const joiner = new AukiBrowserDomainPeer({
    networkPeer: fakeNetworkPeer("peer-joiner", ["/webrtc/p2p/peer-joiner"]),
    discovery,
    appId: "overwatch",
    displayName: "Joiner",
  });

  await manager.createOrJoin({ discoveryUrl: "http://discovery", clusterName: "overwatch" });
  await joiner.declareSensors([{
    sensor_id: "joiner/generated",
    sensor_hash: "joiner-generated-hash",
    kind: "detection",
    label: "Generated",
  }]);
  await joiner.createOrJoin({ discoveryUrl: "http://discovery", clusterName: "overwatch" });
  await new Promise((resolve) => setTimeout(resolve, 0));

  assert.deepEqual(
    manager.snapshot().participants.find((participant) => participant.peer_id === "peer-joiner").sensors,
    [{
      sensor_id: "joiner/generated",
      sensor_hash: "joiner-generated-hash",
      kind: "detection",
      label: "Generated",
    }],
  );
});

class FakeDiscovery {
  constructor() {
    this.clusters = new Map();
  }

  async registerPeerJson(registrationJson) {
    const registration = JSON.parse(registrationJson);
    if (this.clusters.has(registration.name)) {
      return JSON.stringify({ kind: "already_exists" });
    }
    const entry = {
      name: registration.name,
      manager_peer_id: registration.manager_peer_id,
      manager_multiaddrs: registration.manager_multiaddrs,
      relay_multiaddrs: registration.relay_multiaddrs ?? [],
      peer_count: 1,
      created_ns: 1,
      last_liveness_check_ns: 1,
    };
    this.clusters.set(registration.name, entry);
    return JSON.stringify({ kind: "created", entry });
  }

  async discoverPeersJson(queryJson) {
    const query = JSON.parse(queryJson);
    const clusters = [...this.clusters.values()].filter((entry) => !query.name || entry.name === query.name);
    return JSON.stringify({ clusters });
  }
}

const peersByAddress = new Map();

function fakeNetworkPeer(peerId, multiaddrs) {
  const handlers = new Map();
  const peer = {
    peerId,
    multiaddrs,
    async handleFramed(protocol, handler) {
      handlers.set(protocol, handler);
    },
    async requestFramed(peerMultiaddr, protocol, payload) {
      const remote = peersByAddress.get(peerMultiaddr);
      if (!remote) throw new Error(`no fake peer at ${peerMultiaddr}`);
      const handler = remote.handlers.get(protocol);
      if (!handler) throw new Error(`no handler for ${protocol}`);
      return handler(payload, { protocol, connection: { remotePeer: peerId } });
    },
    handlers,
  };
  for (const multiaddr of multiaddrs) {
    peersByAddress.set(multiaddr, peer);
  }
  return peer;
}
