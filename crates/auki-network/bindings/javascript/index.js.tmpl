import initWasm, * as wasm from "./$generated_js_file";

export {
  aukiNetworkProtocolsJson,
  browserProbeProtocol,
  decodeCatalogResponseJson,
  decodeBrowserProbeResponse,
  decodeJoinResponseJson,
  decodeMessageEnvelopeJson,
  encodeCatalogRequestBytes,
  encodeBrowserProbeRequest,
  encodeJoinRequestBytes,
  encodeMessageEnvelopeBytes,
  joinProtocol,
  messageProtocol,
  peerDerivationLabel,
  peerIdFromSeed,
  peerIdFromWalletSeed,
  peerPrivateKeyProtobufFromSeed,
  peerPrivateKeyProtobufFromWalletSeed,
  peerPublicKeyProtobufFromSeed,
  resourcesProtocol,
  sensorsProtocol,
} from "./$generated_js_file";

export default async function initAukiNetwork(input) {
  await initWasm(input);
  return wasm;
}

export async function importAukiPeerPrivateKey(seedInput) {
  const { privateKeyFromProtobuf } = await import("@libp2p/crypto/keys");
  return privateKeyFromProtobuf(peerPrivateKeyProtobuf(seedInput));
}

export async function createAukiNetworkPeer(options = {}) {
  return AukiNetworkPeer.create(options);
}

export async function dialBrowserProbe(options = {}) {
  const { address, nonce = `probe-${Date.now()}`, payload = new Uint8Array(), ...peerOptions } = options;
  if (address == null || address === "") {
    throw new TypeError("dialBrowserProbe requires address");
  }

  const peer = await createAukiNetworkPeer(peerOptions);
  try {
    return await peer.dialBrowserProbe(address, { nonce, payload });
  } finally {
    await peer.stop();
  }
}

export class AukiNetworkPeer {
  constructor(node) {
    this.node = node;
  }

  static async create(options = {}) {
  const [
    { createLibp2p },
    { webRTCDirect },
    { noise },
    { yamux },
    { identify },
    { ping },
    { privateKeyFromProtobuf },
  ] = await Promise.all([
    import("libp2p"),
    import("@libp2p/webrtc"),
    import("@chainsafe/libp2p-noise"),
    import("@chainsafe/libp2p-yamux"),
    import("@libp2p/identify"),
    import("@libp2p/ping"),
    import("@libp2p/crypto/keys"),
  ]);

  const privateKey = privateKeyFromProtobuf(peerPrivateKeyProtobuf(options));
  const node = await createLibp2p({
    privateKey,
    addresses: {
      listen: options.listenAddresses ?? [],
      announce: options.announceAddresses ?? [],
    },
    transports: options.transports ?? [webRTCDirect()],
    connectionEncrypters: options.connectionEncrypters ?? [noise()],
    streamMuxers: options.streamMuxers ?? [yamux()],
    services: {
      identify: identify(),
      ping: ping(),
      ...(options.services ?? {}),
    },
    start: options.start ?? true,
  });

  return new AukiNetworkPeer(node);
  }

  get peerId() {
    return this.node.peerId.toString();
  }

  get multiaddrs() {
    return this.node.getMultiaddrs().map((addr) => addr.toString());
  }

  async start() {
    await this.node.start();
  }

  async stop() {
    await this.node.stop();
  }

  async dialProtocol(address, protocol, options) {
    return this.node.dialProtocol(address, protocol, options);
  }

  async handle(protocol, handler, options) {
    return this.node.handle(protocol, handler, options);
  }

  async unhandle(protocol) {
    return this.node.unhandle(protocol);
  }

  async dialBrowserProbe(peerMultiaddr, options = {}) {
    const nonce = options.nonce ?? `probe-${Date.now()}`;
    const payload = options.payload ?? new Uint8Array();
    const responseBytes = await this.requestFramed(
      peerMultiaddr,
      wasm.browserProbeProtocol(),
      wasm.encodeBrowserProbeRequest(nonce, payload),
    );
    return JSON.parse(wasm.decodeBrowserProbeResponse(responseBytes));
  }

  async sendMessageEnvelope(peerMultiaddr, envelopeBytes) {
    return this.requestFramed(peerMultiaddr, wasm.messageProtocol(), envelopeBytes);
  }

  async requestJoin(peerMultiaddr, requestBytes) {
    return this.requestFramed(peerMultiaddr, wasm.joinProtocol(), requestBytes);
  }

  async requestCatalog(peerMultiaddr, requestBytes) {
    return this.requestFramed(peerMultiaddr, wasm.resourcesProtocol(), requestBytes);
  }

  async requestFramed(peerMultiaddr, protocol, payload) {
    const stream = await this.dialProtocol(await toMultiaddr(peerMultiaddr), protocol);
    await writeLengthPrefixed(stream, payload);
    return readLengthPrefixed(stream);
  }
}

function peerPrivateKeyProtobuf(input) {
  if (input?.walletSeed != null) {
    return wasm.peerPrivateKeyProtobufFromWalletSeed(input.walletSeed);
  }
  if (input?.seed != null) {
    return wasm.peerPrivateKeyProtobufFromSeed(input.seed);
  }
  throw new TypeError("createAukiNetworkPeer requires walletSeed or seed");
}

async function writeLengthPrefixed(stream, payload) {
  const length = new Uint8Array(4);
  new DataView(length.buffer).setUint32(0, payload.length, false);
  if (!stream.send(concatBytes([length, payload]))) {
    await stream.onDrain();
  }
}

async function toMultiaddr(address) {
  if (typeof address !== "string") {
    return address;
  }
  const { multiaddr } = await import("@multiformats/multiaddr");
  return multiaddr(address);
}

async function readLengthPrefixed(source) {
  const reader = source[Symbol.asyncIterator]();
  let pending = new Uint8Array();

  async function readExactly(size) {
    while (pending.length < size) {
      const { value, done } = await reader.next();
      if (done) {
        throw new Error(`stream ended before ${size} bytes were available`);
      }
      pending = concatBytes([pending, chunkBytes(value)]);
    }
    const out = pending.slice(0, size);
    pending = pending.slice(size);
    return out;
  }

  const lengthBytes = await readExactly(4);
  const length = new DataView(lengthBytes.buffer, lengthBytes.byteOffset, lengthBytes.byteLength).getUint32(0, false);
  if (length === 0) {
    throw new Error("browser probe response frame is empty");
  }
  return readExactly(length);
}

function chunkBytes(chunk) {
  if (chunk instanceof Uint8Array) {
    return chunk;
  }
  if (chunk instanceof ArrayBuffer) {
    return new Uint8Array(chunk);
  }
  if (typeof chunk?.subarray === "function") {
    return chunk.subarray();
  }
  throw new TypeError(`unsupported stream chunk: ${Object.prototype.toString.call(chunk)}`);
}

function concatBytes(chunks) {
  const length = chunks.reduce((sum, chunk) => sum + chunk.length, 0);
  const out = new Uint8Array(length);
  let offset = 0;
  for (const chunk of chunks) {
    out.set(chunk, offset);
    offset += chunk.length;
  }
  return out;
}
