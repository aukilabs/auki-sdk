import { readFile } from "node:fs/promises";
import assert from "node:assert/strict";
import test from "node:test";

import initAukiNetwork, { AukiNetworkPeer } from "../index.js";

const wasmBytes = await readFile(new URL("../$generated_wasm_file", import.meta.url));
await initAukiNetwork({ module_or_path: wasmBytes });

test("AukiNetworkPeer sends framed message envelopes", async () => {
  const responseBytes = new Uint8Array([9, 8, 7]);
  const node = new FakeNode(responseBytes);
  const peer = new AukiNetworkPeer(node);
  const envelopeBytes = new Uint8Array([1, 2, 3, 4]);

  const ackBytes = await peer.sendMessageEnvelope({ id: "peer-addr" }, envelopeBytes);

  assert.deepEqual([...ackBytes], [...responseBytes]);
  assert.equal(node.lastProtocol, "/auki/message/0.0.1");
  assert.deepEqual([...node.lastStream.sentPayload()], [...envelopeBytes]);
});

class FakeNode {
  constructor(responseBytes) {
    this.peerId = { toString: () => "fake-peer" };
    this.responseBytes = responseBytes;
  }

  getMultiaddrs() {
    return [];
  }

  async dialProtocol(_address, protocol) {
    this.lastProtocol = protocol;
    this.lastStream = new FakeStream(this.responseBytes);
    return this.lastStream;
  }
}

class FakeStream {
  constructor(responseBytes) {
    this.sent = [];
    this.responseFrame = frame(responseBytes);
  }

  send(bytes) {
    this.sent.push(bytes);
    return true;
  }

  sentPayload() {
    const bytes = this.sent[0];
    const length = new DataView(bytes.buffer, bytes.byteOffset, 4).getUint32(0, false);
    assert.equal(length, bytes.length - 4);
    return bytes.slice(4);
  }

  async *[Symbol.asyncIterator]() {
    yield this.responseFrame.slice(0, 2);
    yield this.responseFrame.slice(2);
  }
}

function frame(payload) {
  const length = new Uint8Array(4);
  new DataView(length.buffer).setUint32(0, payload.length, false);
  const out = new Uint8Array(length.length + payload.length);
  out.set(length, 0);
  out.set(payload, length.length);
  return out;
}
