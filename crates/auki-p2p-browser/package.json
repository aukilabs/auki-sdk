{
  "name": "@aukilabs/auki-p2p-browser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run build:protocol-wasm && vite build --config vite.config.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "build:protocol-wasm": "wasm-pack build ../auki-protocol-wasm --target web --out-dir pkg-web",
    "smoke:import": "node -e \"import('./dist/index.js')\"",
    "test": "npm run build:protocol-wasm && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/circuit-relay-v2": "^4.2.5",
    "@libp2p/crypto": "^5.1.18",
    "@libp2p/identify": "^4.1.6",
    "@libp2p/noise": "^1.0.1",
    "@libp2p/webrtc": "^6.0.23",
    "@libp2p/websockets": "^10.1.13",
    "@multiformats/multiaddr": "^13.0.3",
    "hash-wasm": "^4.12.0",
    "libp2p": "^3.3.1"
  }
}
