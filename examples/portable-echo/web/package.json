{
  "name": "@aukilabs/portable-echo-web-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build:wasm": "wasm-pack build . --target web --out-dir pkg-web --dev -- --locked",
    "check": "npm run build:wasm && tsc --noEmit",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "dev": "npm run build:wasm && vite --host 127.0.0.1",
    "smoke:dev": "node scripts/smoke_browser_native_echo.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
